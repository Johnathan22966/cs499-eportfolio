<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nexventory Dashboard"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/totalItemsHomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Items: 0"
            android:textSize="18sp"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/lowStockHomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low Stock: 0"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/outOfStockHomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Out of Stock: 0"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/viewInventoryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Inventory"
            android:layout_marginTop="32dp" />

        <Button
            android:id="@+id/smsNotificationsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMS Notifications"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log Out"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>
