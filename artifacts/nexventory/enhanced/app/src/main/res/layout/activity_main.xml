<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EFE6"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="Nexventory"
                android:textColor="#2F2F2F"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Inventory Database Dashboard"
                android:textColor="#666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/searchTab"
                android:layout_width="160dp"
                android:layout_height="36dp"
                android:background="#D9C29E"
                android:gravity="center"
                android:text="Search"
                android:textColor="#2F2F2F"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/searchFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#FFF8E8"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Search Inventory"
                    android:textColor="#2F2F2F"
                    android:textStyle="bold" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/searchModeTabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:tabMode="fixed"
                    app:tabGravity="fill" />

                <EditText
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#FFFFFF"
                    android:hint="Search by SKU"
                    android:inputType="text"
                    android:padding="10dp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:labelFor="@id/stockFilterSpinner" android:text="Stock filter" />
            <Spinner android:id="@+id/stockFilterSpinner" android:layout_width="match_parent"
                android:layout_height="48dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:labelFor="@id/sortOrderSpinner" android:text="Sort items by" />
            <Spinner android:id="@+id/sortOrderSpinner" android:layout_width="match_parent"
                android:layout_height="48dp" />
            <Button android:id="@+id/restockButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Show Restock List" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Restock order: out of stock first, then largest shortage. Equal priorities use name and item number."
                android:layout_marginBottom="12dp" />
            <TextView android:id="@+id/resultCountText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/summaryTab"
                android:layout_width="180dp"
                android:layout_height="36dp"
                android:background="#BFD8BD"
                android:gravity="center"
                android:text="Inventory Summary"
                android:textColor="#2F2F2F"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/summaryFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#F4FFF2"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/totalItemsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Total Items: 0"
                    android:textColor="#2F2F2F"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/lowStockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Low Stock: 0"
                    android:textColor="#2F2F2F"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/outOfStockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Out of Stock: 0"
                    android:textColor="#2F2F2F"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/inventoryTab"
                android:layout_width="180dp"
                android:layout_height="36dp"
                android:background="#B9CBE8"
                android:gravity="center"
                android:text="Inventory"
                android:textColor="#2F2F2F"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/inventoryFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#F2F6FF"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Saved Items — tap a row to edit"
                    android:textColor="#2F2F2F"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/inventoryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/noResultsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="No matching items"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/loadSamplesButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Load 15 Sample Items" />

                <Button
                    android:id="@+id/removeSamplesButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Remove Sample Items" />

            </LinearLayout>

            <TextView
                android:id="@+id/addItemTab"
                android:layout_width="180dp"
                android:layout_height="36dp"
                android:background="#D9C29E"
                android:gravity="center"
                android:text="Add or Edit Item"
                android:textColor="#2F2F2F"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/addItemFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#FFF8E8"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/selectedItemText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Adding a new item"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/itemNameInput"
                    android:text="Product name" />

                <EditText
                    android:id="@+id/itemNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="#FFFFFF"
                    android:hint="Item name"
                    android:inputType="text"
                    android:padding="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/itemSkuInput"
                    android:text="SKU" />

                <EditText
                    android:id="@+id/itemSkuInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="#FFFFFF"
                    android:hint="SKU number"
                    android:inputType="text"
                    android:padding="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/itemQuantityInput"
                    android:text="Quantity on hand" />

                <EditText
                    android:id="@+id/itemQuantityInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#FFFFFF"
                    android:hint="Quantity"
                    android:inputType="number"
                    android:padding="10dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:labelFor="@id/minimumStockInput"
                    android:text="Minimum stock target" />
                <EditText android:id="@+id/minimumStockInput" android:layout_width="match_parent"
                    android:layout_height="48dp" android:background="#FFFFFF" android:padding="10dp"
                    android:inputType="number" android:text="5" android:selectAllOnFocus="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Use 0 for no restock target. At the target, no restocking is needed." />

                <Button
                    android:id="@+id/addItemButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="+ Add Item" />

                <Button
                    android:id="@+id/updateItemButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Update Selected Item" />

                <Button
                    android:id="@+id/deleteSelectedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Delete Selected Item" />
            </LinearLayout>

            <TextView
                android:id="@+id/alertsTab"
                android:layout_width="160dp"
                android:layout_height="36dp"
                android:background="#E8B9B9"
                android:gravity="center"
                android:text="Alerts"
                android:textColor="#2F2F2F"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/alertsFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#FFF1F1"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/alertSummaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="No low stock alerts."
                    android:textColor="#2F2F2F"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomNavigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                android:padding="6dp">

                <Button
                    android:id="@+id/homeButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🏠" />

                <Button
                    android:id="@+id/searchButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🔎" />

                <Button
                    android:id="@+id/alertsButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="✉️" />

                <Button
                    android:id="@+id/settingsButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="⚙️" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
