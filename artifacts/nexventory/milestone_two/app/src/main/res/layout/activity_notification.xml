<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notificationMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EFE6"
    tools:context=".NotificationActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Nexventory"
            android:textColor="#2F2F2F"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="SMS Notification Settings"
            android:textColor="#666666"
            android:textSize="16sp" />

        <TextView
            android:layout_width="190dp"
            android:layout_height="36dp"
            android:background="#E8B9B9"
            android:gravity="center"
            android:text="Low Stock Alerts"
            android:textColor="#2F2F2F"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF1F1"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Nexventory can send SMS alerts when inventory is low or out of stock. The app will still work if permission is denied."
                android:textColor="#2F2F2F"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/phoneNumberInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="#FFFFFF"
                android:hint="Phone number for SMS alerts"
                android:inputType="phone"
                android:padding="10dp" />

            <Button
                android:id="@+id/savePhoneButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Save SMS Number" />

            <Button
                android:id="@+id/grantPermissionButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Enable SMS Alerts" />

            <Button
                android:id="@+id/denyPermissionButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Turn Off SMS Alerts" />

            <TextView
                android:id="@+id/smsStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:text="Status: SMS permission has not been granted yet."
                android:textColor="#2F2F2F"
                android:textSize="14sp" />

            <Button
                android:id="@+id/backToInventoryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Back to Inventory" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
